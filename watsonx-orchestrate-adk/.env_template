# IBM Cloud API key used by the ADK to log in to the remote watsonx Orchestrate instance.
export WXO_API_KEY=<YOUR_IBM_CLOUD_API_KEY>

# Service instance URL of your watsonx Orchestrate instance.
# watsonx Orchestrate UI -> profile icon -> Settings -> API details -> Service instance URL
# Format: https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<INSTANCE_ID>
export WXO_URL=<YOUR_SERVICE_INSTANCE_URL>

# Optional (defaults shown)
#export WXO_ENV_NAME=galaxium-remote
