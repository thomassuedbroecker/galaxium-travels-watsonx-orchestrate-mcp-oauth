# Template for deployment-links.env (input of import_existing_deployment.sh --links).
# Same format as the file written by export-deployment.sh --oauth2 in the infrastructure
# repository (deployment/ibm-code-engine/generated/exports/<project>-oauth2-<timestamp>/).
# If you have that file, use it as it is. Otherwise copy this template and set the two required URLs.
# It contains no secrets. The OIDC client secret comes from the deployment's deploy.env.oauth2
# (--deploy-env) or is requested by the import script.

# Required: public URL of the Keycloak application on Code Engine (no trailing slash)
KEYCLOAK_URL="https://<keycloak-app>.<id>.<region>.codeengine.appdomain.cloud"

# Required: public URL of the MCP server application on Code Engine, without /mcp
MCP_BASE_URL="https://<mcp-app>.<id>.<region>.codeengine.appdomain.cloud"

# Written by export-deployment.sh, not used by the import script (derived as ${MCP_BASE_URL}/mcp)
#MCP_ENDPOINT="${MCP_BASE_URL}/mcp"
#CE_PROJECT_NAME=galaxium-travels-oauth2
#IBM_CLOUD_REGION=us-south
#STACK_AUTH_MODE=oauth2

# Optional overrides if the deployment differs from the defaults
#KEYCLOAK_REALM=galaxium
#OIDC_CLIENT_ID=web-app-proxy
